# Flask application
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Security (required in production)
SECRET_KEY=change-me-to-a-long-random-secret-key

# Database (SQLite default; use PostgreSQL in production)
DATABASE_URL=sqlite:///instance/readmission.db

ADMIN_EMAIL=gabriel.odiah@gmail.com
AUTO_PROMOTE_ADMIN=true

# Export limits
PREDICTION_EXPORT_MAX_ROWS=5000
